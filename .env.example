# API Gateway
GATEWAY_PORT=3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Auth & JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Service Ports & Databases
PRODUCT_SERVICE_PORT=3001
MONGO_URI_AUTH=mongodb://localhost:27017/Auth
MONGO_URI_PRODUCTION=mongodb://localhost:27017/product
# Docker Compose (for host development replace mongodb with localhost).
MONGO_URI_INVENTORY=mongodb://admin:secret@mongodb:27017/inventory_db?authSource=admin
MONGO_URI_ORDER=mongodb://admin:secret@mongodb:27017/order_db?authSource=admin

# Redis Cache
REDIS_URL=redis://redis:6379
REDIS_PRODUCT_TTL=60

# false: existing synchronous order flow; true: Redis Streams workers in both services.
ENABLE_ASYNC_ORDER=false

# General
NODE_ENV=development
